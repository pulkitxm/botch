{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Botch",
  "mainBinaryName": "botch",
  "version": "0.0.0",
  "identifier": "com.pulkit.botch",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis"],
    "category": "Utility",
    "shortDescription": "A tiny browser that hangs from the top of the screen",
    "longDescription": "A tabbed browser that lives in a pill at the top of the screen and signs in with one of your Google Chrome profiles.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "web"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
